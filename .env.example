# Optional: without this key, the app uses a safe deterministic explorer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PORT=2000
HEADLESS=false
# Optional login protection for a public deployment. Leave blank for local use.
APP_USERNAME=admin
APP_PASSWORD=
# Maximum safe actions in one session and the visible pause between them.
MAX_STEPS=60
MAX_SESSION_COUNT=10
ACTION_DELAY_MS=1500
CURSOR_MOVE_DELAY_MS=350
CURSOR_TRAVEL_MS=900
BURST_CLICK_DELAY_MS=200
FUS_TERMINATE_DELAY_MS=5000
# Keeps the downloaded Chromium inside this project rather than your user profile.
PLAYWRIGHT_BROWSERS_PATH=0
